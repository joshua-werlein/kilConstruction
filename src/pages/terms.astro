---
import BaseLayout from "../layout/MainLayout.astro";
import "../styles/legal.css";

// Final revision 2026-10-18: approved by the site owner; business-practice
// claims owner-confirmed 2026-10-19 (docs/facebook-launch-resume.md).
// Keep LAST_UPDATED = date of the last text change; bump it if edited again.
const LAST_UPDATED = "October 18, 2026";

const title = "Terms of Use | KIL Construction";
const description =
    "Terms of Use for kilcon.work outlining conditions for accessing and using the website.";
---

<BaseLayout {title} {description}>
    <article class="legal">
        <h1>Terms of Use</h1>
        <p class="muted">Last updated: {LAST_UPDATED}</p>

        <p>
            By accessing or using kilcon.work, you agree to these Terms of Use.
        </p>

        <h2>Purpose of the Site</h2>
        <p>
            kilcon.work is provided for informational and business purposes. Content
            may be updated, modified, or removed at any time without notice.
        </p>

        <h2>No Warranties</h2>
        <p>
            The website is provided “as is” and “as available.” We make no warranties
            regarding accuracy, availability, or suitability for any purpose. Use of
            the site is at your own risk.
        </p>

        <h2>Intellectual Property</h2>
        <p>
            All original content on this site, unless otherwise stated, is the
            property of KIL Construction and may not be reproduced or reused without
            permission.
        </p>

        <h2>User Submissions</h2>
        <p>
            If you submit information through site forms, you grant permission for us
            to review and respond to your submission and confirm that the information
            provided is lawful and accurate.
        </p>

        <h2>Reviews and Photos You Submit</h2>
        <p>
            If you submit a review, it may be displayed on the site once approved, as
            described in our <a href="/privacy">Privacy Policy</a>. By uploading a photo,
            you confirm that you have the right to share it. You can ask us to remove
            your review at any time.
        </p>

        <h2>Privacy</h2>
        <p>
            Our <a href="/privacy">Privacy Policy</a> explains how we handle information,
            including project photos we publish from our Facebook Page. To ask us to
            delete information or content, see <a href="/data-deletion">Data Deletion</a>.
        </p>

        <h2>Limitation of Liability</h2>
        <p>
            To the fullest extent permitted by law, KIL Construction is not liable for
            any damages arising from the use of, or inability to use, this website.
        </p>

        <h2>Changes to the Site or Terms</h2>
        <p>
            We reserve the right to modify site content or these Terms at any time.
            Continued use of the site constitutes acceptance of any updates.
        </p>

        <h2>Governing Law</h2>
        <p>
            These Terms are governed by the laws of the State of
            <strong>Wisconsin</strong>, United States.
        </p>
    </article>
</BaseLayout>
