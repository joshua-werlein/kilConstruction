---
import { runtimeEnv } from "../../utils/runtimeEnv";
import MainLayout from "../../layout/MainLayout.astro";
import "../../styles/global.css";
import "../../styles/projects.css";
import { normalizeApparelSlug } from "../../utils/apparelSlug";
import { sizeOptions, MAX_QTY, MAX_NOTES_LENGTH, MAX_SIZE_LENGTH, MAX_NAME_LENGTH, MAX_EMAIL_LENGTH } from "../../lib/apparel-inquiry.js";
import { TURNSTILE_SITE_KEY, CONTACT_ENDPOINT } from "../../config/publicConfig";

export const prerender = false;

type Photo = {
    name: string;
    thumb: string;
    full: string;
    description?: string;
};

type ProjectMeta = {
    name?: string;
    description?: string;
};

const { slug: rawSlug } = Astro.params as { slug?: string };

// Only valid slugs may reach the page (they are written into data attributes
// and the /contact link the request form builds).
const slug = normalizeApparelSlug(rawSlug);
if (!slug) return new Response(null, { status: 404 });
if (slug !== rawSlug) {
    // The gallery worker matches case-insensitively; keep old mixed-case links working.
    return new Response(null, {
        status: 301,
        headers: { Location: `/apparel/${slug}${Astro.url.search}` },
    });
}

const env = runtimeEnv;
const GALLERY_WORKER = env?.GALLERY_WORKER as Fetcher | undefined;
if (!GALLERY_WORKER) throw new Error("Missing service binding: GALLERY_WORKER");

let items: Photo[] = [];
let loadError: string | null = null;
let albumName: string = slugToTitle(slug);
let albumDesc: string | undefined;

async function workerFetchJsonWithRetry(binding: any, url: string, tries = 2): Promise<Response | null> {
    let last: Response | null = null;
    for (let i = 0; i < tries; i++) {
        try {
            const req = new Request(url, {
                method: "GET",
                headers: {
                    Accept: "application/json",
                    "Cache-Control": "no-store",
                    Pragma: "no-cache",
                },
                cf: { cacheTtl: 0, cacheEverything: false },
            });
            const res = await binding.fetch(req);
            last = res;
            const ct = res.headers.get("content-type") || "";
            if (res.ok && ct.includes("application/json")) return res;
        } catch {
            // retry
        }
        await new Promise((r) => setTimeout(r, 150 * (i + 1)));
    }
    return last;
}

try {
    // 1) Apparel-specific request
    const API = new URL('/api/gallery-api', 'https://kilcon.work');
    const apiItems = new URL(API);
    apiItems.searchParams.set("project", `apparel/${slug}`);
    const r1 = await workerFetchJsonWithRetry(GALLERY_WORKER, apiItems.toString());

    if (!r1 || !r1.ok) {
        if (!r1 || r1.status !== 404) {
            loadError = r1 ? `HTTP ${r1.status}` : "Gallery unavailable";
        }
    } else if (!r1.headers.get("content-type")?.includes("application/json")) {
        loadError = "Bad response (not JSON)";
    } else {
        const j1 = (await r1.json()) as { items?: Photo[]; project?: ProjectMeta };
        items = j1.items ?? [];
        items.sort((a, b) =>
            a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: "base" }),
        );

        if (j1.project?.name) albumName = j1.project.name;
        if (j1.project?.description) albumDesc = j1.project.description;
    }

    // 2) optional meta from apparel list
    if (!albumDesc) {
        const apiList = new URL(API);
        apiList.searchParams.set("list", "apparel");

        const r2 = await workerFetchJsonWithRetry(GALLERY_WORKER, apiList.toString());
        if (r2 && r2.ok && r2.headers.get("content-type")?.includes("application/json")) {
            const j2 = (await r2.json()) as {
                apparel?: { slug: string; name?: string; description?: string }[];
                projects?: { slug: string; name?: string; description?: string }[];
            };

            const list = j2.apparel ?? j2.projects ?? [];
            const m = list.find((p) => p.slug === slug);
            if (m?.name) albumName = m.name;
            if (m?.description) albumDesc = m.description;
        }
    }
} catch (e: any) {
    loadError = e?.message ?? "Network error";
}

const cropName = (s: string) =>
    s
        .replace(/\.[^.]+$/, "")        // remove extension
        .replace(/[_]+/g, " ")          // underscores -> spaces
        .replace(/^\s*\d+[\s_-]*/, "")  // strip leading digits + separators
        .replace(/[\s_-]*\d+\s*$/, "")  // strip trailing digits + separators
        .trim();

function slugToTitle(s: string): string {
    return s
        .split("-")
        .filter(Boolean)
        .map((part) => part[0]?.toUpperCase() + part.slice(1))
        .join(" ");
}
// Sizes for the request form (rendered on the server). Admin-enabled sizes are
// listed; stock and price never block a request. If the database is unavailable,
// the standard sizes are offered so the customer can still ask.
type VariantRow = { size: string; active: number; stock: number };
let variantRows: VariantRow[] = [];
try {
    const db = env?.DB;
    if (db) {
        const row = await db.prepare("SELECT id FROM apparel_items WHERE slug = ? AND active = 1").bind(slug).first();
        if (row) {
            const res = await db.prepare(
                `SELECT size, active, stock FROM apparel_variants WHERE item_id = ?
                 ORDER BY CASE size WHEN 'S' THEN 1 WHEN 'M' THEN 2 WHEN 'L' THEN 3 WHEN 'XL' THEN 4
                 WHEN 'XXL' THEN 5 WHEN 'XXXL' THEN 6 WHEN 'XXXXL' THEN 7 ELSE 99 END`
            ).bind(row.id).all();
            variantRows = (res.results ?? []) as VariantRow[];
        }
    }
} catch (e) {
    console.error("[apparel] size lookup failed", e);
}
const sizes = sizeOptions(variantRows);

const metaDescription =
    albumDesc
        ? `${albumName} – ${albumDesc}`
        : `${albumName} from KIL Construction – view styles and request this item.`;
---

<MainLayout title={albumName} description={metaDescription} noSticky>
    <h1 class="page-head container">{albumName}</h1>

    {albumDesc && (
            <p class="container muted" style="margin-top:-6px;margin-bottom:14px;">
                {albumDesc}
            </p>
    )}

    <section class="container page-section">
        {items.length > 0 ? (
            <div class="grid grid--projects">
                {items.map((i, index) => {
                    // 1) Base: service/album name in this page
                    const base = albumName;

                    // 2) Start from your existing filename helper (cropName)
                    let cleanedName = cropName ? cropName(i.name) : i.name;

                    // 3) Strip leading IMG_/DSC_ etc.
                    cleanedName = cleanedName.replace(/^(IMG|DSC)[-_]*/i, "").trim();

                    // 4) Prefer item description; fall back to cleaned filename; then to a generic label
                    const sceneLabel =
                        (i.description && i.description.trim()) ||
                        cleanedName ||
                        `project photo ${index + 1}`;

                    const alt = `${base} – ${sceneLabel}`;

                    return (
                        <figure class="card card-media">
                            <a href={i.full || i.thumb} target="_blank" rel="noopener">
                                <img
                                    class="photo"
                                    loading="lazy"
                                    decoding="async"
                                    referrerpolicy="no-referrer"
                                    src={i.thumb || i.full}
                                    srcset={`${(i.thumb || i.full).replace('=s0','=w600')} 600w, ${(i.thumb || i.full).replace('=s0','=w1200')} 1200w, ${(i.thumb || i.full).replace('=s0','=w2000')} 2000w`}
                                    alt={alt}
                                    sizes="(max-width: 560px) 90vw, (max-width: 1200px) 45vw, 28vw"
                                />
                            </a>
                            {(i.description || i.name) && (
                                <figcaption class="caption">
                                    {i.description || cropName(i.name)}
                                </figcaption>
                            )}
                        </figure>
                    );
                })}
            </div>
        ) : (
            !loadError && <p>No images uploaded yet.</p>
        )}

        {loadError && <p class="error">Failed to load: {loadError}</p>}
    </section>

    {/* Apparel request form: no online payment. With JavaScript it is sent directly to the
        Contact Worker (same Turnstile, honeypot, rate limit and Resend delivery as /contact). */}
    <section class="container page-section">
        <h2 style="text-align: center;">Request {albumName}</h2>

        <p class="muted" style="text-align: center;">
            We don't take payment online. Send a request and we'll confirm price, availability, and pickup or delivery with you.
        </p>

        <div id="requestSuccess" class="apparel-success" role="status" tabindex="-1" hidden>
            <h3>Request sent</h3>
            <p id="requestSuccessText">Thanks! We received your request and will reply by email to confirm price, availability, and pickup or delivery.</p>
            <button id="requestAnother" type="button" class="btn cta">Request another item</button>
        </div>

        {/* No-JavaScript fallback: this GET form opens /contact. Only item, size and quantity
            have `name` attributes; name, email, notes, the honeypot and the Turnstile token
            don't, so personal details can never end up in a URL. */}
        <form id="requestForm" class="apparel-form" method="get" action="/contact" data-slug={slug} data-title={albumName} data-endpoint={CONTACT_ENDPOINT} novalidate>
            <input type="hidden" name="inquiry" value="apparel" />
            <input type="hidden" name="item" value={slug} />
            <input type="hidden" name="title" value={albumName} />

            <noscript>
                <p class="apparel-noscript">JavaScript is off, so this form can't be sent from here. Pressing the button opens our contact page, where you can call, email, or send your request.</p>
            </noscript>

            <p class="muted apparel-required-note">All fields are required unless marked optional.</p>

            <label for="nameInput">Full Name</label>
            <input id="nameInput" type="text" autocomplete="name" maxlength={MAX_NAME_LENGTH} required aria-required="true" aria-describedby="nameError" />
            <p id="nameError" class="field-error" hidden></p>

            <label for="emailInput">Email Address</label>
            <input id="emailInput" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" maxlength={MAX_EMAIL_LENGTH} required aria-required="true" aria-describedby="emailError" />
            <p id="emailError" class="field-error" hidden></p>

            <label for="sizeSelect">Size</label>
            <select id="sizeSelect" name="size" required aria-required="true" aria-describedby="sizeError">
                <option value="">Select size…</option>
                {sizes.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
            <p id="sizeError" class="field-error" hidden></p>

            <div id="customSizeRow" hidden>
                <label for="customSize">Requested size</label>
                <input id="customSize" name="customSize" type="text" maxlength={MAX_SIZE_LENGTH} placeholder="e.g. 5XL, Tall L, Youth M" autocomplete="off" aria-describedby="customSizeError" />
                <p id="customSizeError" class="field-error" hidden></p>
            </div>

            <label for="qtyInput">Quantity</label>
            <input id="qtyInput" name="qty" type="number" inputmode="numeric" min="1" max={MAX_QTY} step="1" value="1" required aria-required="true" aria-describedby="qtyError" />
            <p id="qtyError" class="field-error" hidden></p>

            <label for="notesInput">Notes (optional)</label>
            <textarea id="notesInput" rows="3" maxlength={MAX_NOTES_LENGTH} placeholder="Colors, names or logos, when you need it…"></textarea>

            {/* Honeypot: hidden from people and assistive technology; bots that fill it are dropped by the Worker. */}
            <div class="apparel-hp" aria-hidden="true">
                <label for="apparelCompany">Company</label>
                <input id="apparelCompany" type="text" tabindex="-1" autocomplete="off" />
            </div>

            {/* Rendered explicitly by the script below: "flexible" needs 300px, so narrow
                phones get the "compact" widget. No hidden token input (response-field off). */}
            <div
                id="apparelTurnstile"
                class="apparel-turnstile"
                data-sitekey={TURNSTILE_SITE_KEY}
                aria-label="Verification step to prevent spam and automated submissions">
            </div>

            <p class="muted apparel-privacy-note">Your request is emailed to KIL Construction. It isn't stored on this site, and we reply to the email address you enter.</p>

            <p id="requestError" class="status" style="text-align: center;" role="alert"></p>

            <div class="apparel-buttons">
                <button id="requestBtn" type="submit" class="btn cta">Request This Item</button>
                <a class="btn cta btn-secondary" href="/apparel">Back to apparel</a>
            </div>
        </form>
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=kilApparelTurnstileLoad" async defer></script>
    </section>
    <script>
        import { OTHER_SIZE, validateRequestForm } from "../../lib/apparel-inquiry.js";
        import { buildSubmission, submitInquiry, messageFor } from "../../lib/apparel-submit.js";

        type TurnstileApi = {
            render(el: HTMLElement, opts: Record<string, unknown>): string | undefined;
            getResponse(id?: string): string | undefined;
            reset(id?: string): void;
            isExpired?(id?: string): boolean;
        };
        const ts = () => (window as unknown as { turnstile?: TurnstileApi }).turnstile;

        const form = document.getElementById("requestForm") as HTMLFormElement | null;
        const nameInput = document.getElementById("nameInput") as HTMLInputElement | null;
        const emailInput = document.getElementById("emailInput") as HTMLInputElement | null;
        const sizeSelect = document.getElementById("sizeSelect") as HTMLSelectElement | null;
        const customRow = document.getElementById("customSizeRow");
        const customInput = document.getElementById("customSize") as HTMLInputElement | null;
        const qtyInput = document.getElementById("qtyInput") as HTMLInputElement | null;
        const notesInput = document.getElementById("notesInput") as HTMLTextAreaElement | null;
        const honeypot = document.getElementById("apparelCompany") as HTMLInputElement | null;
        const widget = document.getElementById("apparelTurnstile");
        const button = document.getElementById("requestBtn") as HTMLButtonElement | null;
        const errorEl = document.getElementById("requestError");
        const success = document.getElementById("requestSuccess");
        const another = document.getElementById("requestAnother");

        // Turnstile, rendered explicitly. Tokens are single use and expire after 5 minutes;
        // refresh-expired "auto" renews them. The callbacks only clear or set the hint; the
        // submit handler reads the token itself.
        let widgetId: string | undefined;
        function renderTurnstile() {
            const api = ts();
            if (!api || !widget || widgetId !== undefined) return;
            widgetId = api.render(widget, {
                sitekey: widget.dataset.sitekey,
                theme: "auto",
                size: widget.clientWidth < 300 ? "compact" : "flexible",
                "response-field": false,
                "refresh-expired": "auto",
                callback: () => { if (errorEl?.dataset.code === "verification") setError(""); },
                "expired-callback": () => setError(messageFor("verification"), "verification"),
                "error-callback": () => setError(messageFor("verification"), "verification"),
            });
        }
        // api.js is async: it calls kilApparelTurnstileLoad when it loads after this
        // script, and if it loaded first, window.turnstile already exists.
        Object.assign(window, { kilApparelTurnstileLoad: renderTurnstile });
        renderTurnstile();

        // error code -> [field id, its error element id, message]
        const FIELDS: Record<string, [string, string, string]> = {
            name: ["nameInput", "nameError", "Please enter your full name (letters, spaces, hyphens or apostrophes)."],
            email: ["emailInput", "emailError", "Please enter a valid email address, like name@example.com."],
            size: ["sizeSelect", "sizeError", "Please select a size."],
            custom_size: ["customSize", "customSizeError", "Please enter the size you need."],
            quantity: ["qtyInput", "qtyError", "Quantity must be a whole number from 1 to 99."],
        };
        const ITEM_ERROR = "This item can't be requested right now. Please use the contact form.";

        function setError(text: string, code = "") {
            if (!errorEl) return;
            errorEl.textContent = text;
            errorEl.dataset.code = code;
        }

        function clearErrors() {
            setError("");
            for (const [fieldId, id] of Object.values(FIELDS)) {
                document.getElementById(fieldId)?.removeAttribute("aria-invalid");
                const msg = document.getElementById(id);
                if (msg) { msg.textContent = ""; msg.hidden = true; }
            }
        }

        function showErrors(codes: ReadonlyArray<string | undefined>) {
            let first: HTMLElement | null = null;
            for (const code of codes) {
                const entry = code ? FIELDS[code] : undefined;
                if (!entry) { setError(ITEM_ERROR, "item"); continue; }
                const [fieldId, id, text] = entry;
                const field = document.getElementById(fieldId);
                field?.setAttribute("aria-invalid", "true");
                const msg = document.getElementById(id);
                if (msg) { msg.textContent = text; msg.hidden = false; }
                first ??= field;
            }
            if (first) setError(codes.length > 1 ? `Please fix the ${codes.length} highlighted fields.` : "Please fix the highlighted field.", "fields");
            first?.focus();
        }

        function syncCustom() {
            const other = sizeSelect?.value === OTHER_SIZE;
            if (customRow) customRow.hidden = !other;
            if (customInput) customInput.required = other;
        }

        function setBusy(busy: boolean) {
            if (!button || !form) return;
            button.disabled = busy;
            button.textContent = busy ? "Sending…" : "Request This Item";
            form.setAttribute("aria-busy", busy ? "true" : "false");
        }

        function resetTurnstile() {
            try { if (widgetId !== undefined) ts()?.reset(widgetId); } catch { /* widget not ready */ }
        }

        let inFlight = false;

        if (form && sizeSelect) {
            sizeSelect.addEventListener("change", syncCustom);
            syncCustom();

            form.addEventListener("submit", async (e) => {
                e.preventDefault(); // never navigate with JavaScript on: no details in any URL
                if (inFlight) return; // double-click / Enter while sending
                clearErrors();
                const result = validateRequestForm({
                    name: nameInput?.value ?? "",
                    email: emailInput?.value ?? "",
                    slug: form.dataset.slug ?? "",
                    title: form.dataset.title ?? "",
                    size: sizeSelect.value,
                    customSize: customInput?.value ?? "",
                    quantity: qtyInput?.value ?? "",
                    notes: notesInput?.value ?? "",
                });
                if (!result.ok || !result.request || !result.contact) {
                    showErrors(result.errors ?? ["item"]);
                    return;
                }
                let token = "";
                try { token = (widgetId !== undefined && ts()?.getResponse(widgetId)) || ""; } catch { token = ""; }
                let expired = false;
                try { expired = !!(widgetId !== undefined && ts()?.isExpired?.(widgetId)); } catch { expired = false; }
                if (!token || expired) {
                    if (expired) resetTurnstile();
                    setError(messageFor("verification"), "verification");
                    widget?.scrollIntoView({ block: "center", behavior: "smooth" });
                    return;
                }

                inFlight = true;
                setBusy(true);
                const outcome = await submitInquiry(window.fetch.bind(window), form.dataset.endpoint || "/api/contact",
                    buildSubmission({ request: result.request, contact: result.contact, token, honeypot: honeypot?.value ?? "" }));
                inFlight = false;
                setBusy(false);
                resetTurnstile(); // a token is valid for one verification only

                if (outcome.ok) {
                    form.hidden = true;
                    form.reset();
                    syncCustom();
                    if (success) { success.hidden = false; success.focus(); }
                    return;
                }
                // Keep every entry so the customer can simply retry.
                setError(messageFor(outcome.code), outcome.code);
                if (outcome.code === "input") (nameInput ?? emailInput)?.focus();
            });

            another?.addEventListener("click", () => {
                if (success) success.hidden = true;
                form.hidden = false;
                clearErrors();
                nameInput?.focus();
            });
        }
    </script>
    <style>

        .apparel-form {
            max-width: 520px;
            margin: 0 auto;
        }

        .apparel-form label {
            font-size: 1rem;
        }

        /* global.css sets form{display:grid}, which would override the hidden attribute. */
        .apparel-form[hidden],
        .apparel-success[hidden] {
            display: none;
        }

        .apparel-success {
            max-width: 520px;
            margin: 0 auto;
            padding: 16px 20px;
            border: 2px solid #506631;
            border-radius: 10px;
            text-align: center;
        }

        .apparel-success h3 {
            margin: 0 0 6px;
            color: #506631;
        }

        .apparel-success:focus {
            outline: 3px solid #506631;
            outline-offset: 3px;
        }

        /* Honeypot: off-screen, not display:none (some bots skip hidden fields). */
        .apparel-hp {
            position: absolute;
            left: -10000px;
            width: 1px;
            height: 1px;
            overflow: hidden;
        }

        .apparel-turnstile {
            display: flex;
            justify-content: center;
            min-height: 65px;
            max-width: 100%;
        }

        .apparel-noscript {
            text-align: center;
            font-weight: 600;
        }

        .apparel-form .field-error {
            color: #c0392b;
            font-size: 0.95rem;
            margin: -6px 0 0;
        }

        .apparel-form [aria-invalid="true"] {
            border-color: #c0392b;
            outline: 2px solid #c0392b;
            outline-offset: 1px;
        }

        .apparel-required-note,
        .apparel-privacy-note {
            text-align: center;
        }

        .apparel-form select,
        .apparel-form input[type="text"],
        .apparel-form input[type="email"],
        .apparel-form input[type="number"],
        .apparel-form textarea {
            width: 100%;
            max-width: 420px;
            font-size: 16px;
            line-height: 1.25;
            padding: 10px 12px;
            min-height: 44px;
            box-sizing: border-box;
            border-radius: 8px;
            margin: 0 auto;
            display: block;
        }

        .apparel-form select:disabled,
        .apparel-form input:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

        .apparel-form .muted {
            font-size: 0.95rem;
        }

        .apparel-buttons{
            display:flex;
            justify-content:center;
            align-items:center;
            gap:16px;
            margin-top: 18px;
            flex-wrap: wrap;
        }

        .apparel-buttons .btn{
            min-width: 180px;
            min-height: 44px; /* touch target */
            text-align:center;
        }

        .btn-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            color: #fff;
        }

        .btn-link:visited {
            color: #fff;
        }
    </style>
</MainLayout>
