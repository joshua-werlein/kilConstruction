---
import { runtimeEnv } from "../../utils/runtimeEnv";
import MainLayout from "../../layout/MainLayout.astro";
import "../../styles/global.css";
import "../../styles/projects.css";
import { normalizeApparelSlug } from "../../utils/apparelSlug";
import { sizeOptions, MAX_QTY, MAX_NOTES_LENGTH, MAX_SIZE_LENGTH } from "../../lib/apparel-inquiry.js";

export const prerender = false;

type Photo = {
    name: string;
    thumb: string;
    full: string;
    description?: string;
};

type ProjectMeta = {
    name?: string;
    description?: string;
};

const { slug: rawSlug } = Astro.params as { slug?: string };

// Only valid slugs may reach the page (they are written into data attributes
// and the /contact link the request form builds).
const slug = normalizeApparelSlug(rawSlug);
if (!slug) return new Response(null, { status: 404 });
if (slug !== rawSlug) {
    // The gallery worker matches case-insensitively; keep old mixed-case links working.
    return new Response(null, {
        status: 301,
        headers: { Location: `/apparel/${slug}${Astro.url.search}` },
    });
}

const env = runtimeEnv;
const GALLERY_WORKER = env?.GALLERY_WORKER as Fetcher | undefined;
if (!GALLERY_WORKER) throw new Error("Missing service binding: GALLERY_WORKER");

let items: Photo[] = [];
let loadError: string | null = null;
let albumName: string = slugToTitle(slug);
let albumDesc: string | undefined;

async function workerFetchJsonWithRetry(binding: any, url: string, tries = 2): Promise<Response | null> {
    let last: Response | null = null;
    for (let i = 0; i < tries; i++) {
        try {
            const req = new Request(url, {
                method: "GET",
                headers: {
                    Accept: "application/json",
                    "Cache-Control": "no-store",
                    Pragma: "no-cache",
                },
                cf: { cacheTtl: 0, cacheEverything: false },
            });
            const res = await binding.fetch(req);
            last = res;
            const ct = res.headers.get("content-type") || "";
            if (res.ok && ct.includes("application/json")) return res;
        } catch {
            // retry
        }
        await new Promise((r) => setTimeout(r, 150 * (i + 1)));
    }
    return last;
}

try {
    // 1) Apparel-specific request
    const API = new URL('/api/gallery-api', 'https://kilcon.work');
    const apiItems = new URL(API);
    apiItems.searchParams.set("project", `apparel/${slug}`);
    const r1 = await workerFetchJsonWithRetry(GALLERY_WORKER, apiItems.toString());

    if (!r1 || !r1.ok) {
        if (!r1 || r1.status !== 404) {
            loadError = r1 ? `HTTP ${r1.status}` : "Gallery unavailable";
        }
    } else if (!r1.headers.get("content-type")?.includes("application/json")) {
        loadError = "Bad response (not JSON)";
    } else {
        const j1 = (await r1.json()) as { items?: Photo[]; project?: ProjectMeta };
        items = j1.items ?? [];
        items.sort((a, b) =>
            a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: "base" }),
        );

        if (j1.project?.name) albumName = j1.project.name;
        if (j1.project?.description) albumDesc = j1.project.description;
    }

    // 2) optional meta from apparel list
    if (!albumDesc) {
        const apiList = new URL(API);
        apiList.searchParams.set("list", "apparel");

        const r2 = await workerFetchJsonWithRetry(GALLERY_WORKER, apiList.toString());
        if (r2 && r2.ok && r2.headers.get("content-type")?.includes("application/json")) {
            const j2 = (await r2.json()) as {
                apparel?: { slug: string; name?: string; description?: string }[];
                projects?: { slug: string; name?: string; description?: string }[];
            };

            const list = j2.apparel ?? j2.projects ?? [];
            const m = list.find((p) => p.slug === slug);
            if (m?.name) albumName = m.name;
            if (m?.description) albumDesc = m.description;
        }
    }
} catch (e: any) {
    loadError = e?.message ?? "Network error";
}

const cropName = (s: string) =>
    s
        .replace(/\.[^.]+$/, "")        // remove extension
        .replace(/[_]+/g, " ")          // underscores -> spaces
        .replace(/^\s*\d+[\s_-]*/, "")  // strip leading digits + separators
        .replace(/[\s_-]*\d+\s*$/, "")  // strip trailing digits + separators
        .trim();

function slugToTitle(s: string): string {
    return s
        .split("-")
        .filter(Boolean)
        .map((part) => part[0]?.toUpperCase() + part.slice(1))
        .join(" ");
}
// Sizes for the request form (rendered on the server). Admin-enabled sizes are
// listed; stock and price never block a request. If the database is unavailable,
// the standard sizes are offered so the customer can still ask.
type VariantRow = { size: string; active: number; stock: number };
let variantRows: VariantRow[] = [];
try {
    const db = env?.DB;
    if (db) {
        const row = await db.prepare("SELECT id FROM apparel_items WHERE slug = ? AND active = 1").bind(slug).first();
        if (row) {
            const res = await db.prepare(
                `SELECT size, active, stock FROM apparel_variants WHERE item_id = ?
                 ORDER BY CASE size WHEN 'S' THEN 1 WHEN 'M' THEN 2 WHEN 'L' THEN 3 WHEN 'XL' THEN 4
                 WHEN 'XXL' THEN 5 WHEN 'XXXL' THEN 6 WHEN 'XXXXL' THEN 7 ELSE 99 END`
            ).bind(row.id).all();
            variantRows = (res.results ?? []) as VariantRow[];
        }
    }
} catch (e) {
    console.error("[apparel] size lookup failed", e);
}
const sizes = sizeOptions(variantRows);

const metaDescription =
    albumDesc
        ? `${albumName} – ${albumDesc}`
        : `${albumName} from KIL Construction – view styles and request this item.`;
---

<MainLayout title={albumName} description={metaDescription} noSticky>
    <h1 class="page-head container">{albumName}</h1>

    {albumDesc && (
            <p class="container muted" style="margin-top:-6px;margin-bottom:14px;">
                {albumDesc}
            </p>
    )}

    <section class="container page-section">
        {items.length > 0 ? (
            <div class="grid grid--projects">
                {items.map((i, index) => {
                    // 1) Base: service/album name in this page
                    const base = albumName;

                    // 2) Start from your existing filename helper (cropName)
                    let cleanedName = cropName ? cropName(i.name) : i.name;

                    // 3) Strip leading IMG_/DSC_ etc.
                    cleanedName = cleanedName.replace(/^(IMG|DSC)[-_]*/i, "").trim();

                    // 4) Prefer item description; fall back to cleaned filename; then to a generic label
                    const sceneLabel =
                        (i.description && i.description.trim()) ||
                        cleanedName ||
                        `project photo ${index + 1}`;

                    const alt = `${base} – ${sceneLabel}`;

                    return (
                        <figure class="card card-media">
                            <a href={i.full || i.thumb} target="_blank" rel="noopener">
                                <img
                                    class="photo"
                                    loading="lazy"
                                    decoding="async"
                                    referrerpolicy="no-referrer"
                                    src={i.thumb || i.full}
                                    srcset={`${(i.thumb || i.full).replace('=s0','=w600')} 600w, ${(i.thumb || i.full).replace('=s0','=w1200')} 1200w, ${(i.thumb || i.full).replace('=s0','=w2000')} 2000w`}
                                    alt={alt}
                                    sizes="(max-width: 560px) 90vw, (max-width: 1200px) 45vw, 28vw"
                                />
                            </a>
                            {(i.description || i.name) && (
                                <figcaption class="caption">
                                    {i.description || cropName(i.name)}
                                </figcaption>
                            )}
                        </figure>
                    );
                })}
            </div>
        ) : (
            !loadError && <p>No images uploaded yet.</p>
        )}

        {loadError && <p class="error">Failed to load: {loadError}</p>}
    </section>

    {/* Apparel request form: no online payment. Sends the customer to /contact with the request prefilled. */}
    <section class="container page-section">
        <h2 style="text-align: center;">Request {albumName}</h2>

        <p class="muted" style="text-align: center;">
            We don't take payment online. Send a request and we'll confirm price, availability, and pickup or delivery with you.
        </p>

        <form id="requestForm" class="apparel-form" method="get" action="/contact" data-slug={slug} data-title={albumName} novalidate>
            <input type="hidden" name="inquiry" value="apparel" />
            <input type="hidden" name="item" value={slug} />
            <input type="hidden" name="title" value={albumName} />

            <label for="sizeSelect">Size</label>
            <select id="sizeSelect" name="size" required>
                <option value="">Select size…</option>
                {sizes.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>

            <div id="customSizeRow" hidden>
                <label for="customSize">Requested size</label>
                <input id="customSize" name="customSize" type="text" maxlength={MAX_SIZE_LENGTH} placeholder="e.g. 5XL, Tall L, Youth M" autocomplete="off" />
            </div>

            <label for="qtyInput">Quantity</label>
            <input id="qtyInput" name="qty" type="number" min="1" max={MAX_QTY} step="1" value="1" required />

            <label for="notesInput">Notes (optional)</label>
            <textarea id="notesInput" name="notes" rows="3" maxlength={MAX_NOTES_LENGTH} placeholder="Colors, names or logos, when you need it…"></textarea>

            <p id="requestError" class="status" style="text-align: center;" aria-live="polite"></p>

            <div class="apparel-buttons">
                <button id="requestBtn" type="submit" class="btn cta">Request This Item</button>
                <a class="btn cta btn-secondary" href="/apparel">Back to apparel</a>
            </div>
        </form>
    </section>
    <script>
        import { OTHER_SIZE, NOTES_STORAGE_KEY, validateInquiry, inquiryQuery } from "../../lib/apparel-inquiry.js";

        const form = document.getElementById("requestForm") as HTMLFormElement | null;
        const sizeSelect = document.getElementById("sizeSelect") as HTMLSelectElement | null;
        const customRow = document.getElementById("customSizeRow");
        const customInput = document.getElementById("customSize") as HTMLInputElement | null;
        const qtyInput = document.getElementById("qtyInput") as HTMLInputElement | null;
        const notesInput = document.getElementById("notesInput") as HTMLTextAreaElement | null;
        const errorEl = document.getElementById("requestError");

        const MESSAGES: Record<string, string> = {
            size: "Please select a size.",
            custom_size: "Please enter the size you need.",
            quantity: "Quantity must be a whole number from 1 to 99.",
            item: "This item can't be requested right now. Please use the contact form.",
        };

        function syncCustom() {
            const other = sizeSelect?.value === OTHER_SIZE;
            if (customRow) customRow.hidden = !other;
            if (customInput) customInput.required = other;
        }

        if (form && sizeSelect) {
            sizeSelect.addEventListener("change", () => { if (errorEl) errorEl.textContent = ""; syncCustom(); });
            syncCustom();

            form.addEventListener("submit", (e) => {
                e.preventDefault();
                const result = validateInquiry({
                    slug: form.dataset.slug ?? "",
                    title: form.dataset.title ?? "",
                    size: sizeSelect.value,
                    customSize: customInput?.value ?? "",
                    quantity: qtyInput?.value ?? "",
                    notes: notesInput?.value ?? "",
                });
                const request = result.ok ? result.request : undefined;
                if (!request) {
                    if (errorEl) errorEl.textContent = MESSAGES[result.error ?? "item"] ?? MESSAGES.item;
                    return;
                }
                // Notes can be personal: hand them over in this tab's sessionStorage, never in the URL.
                try {
                    if (request.notes) sessionStorage.setItem(NOTES_STORAGE_KEY, request.notes);
                    else sessionStorage.removeItem(NOTES_STORAGE_KEY);
                } catch { /* storage blocked: the customer can retype notes on the contact form */ }
                window.location.assign(`/contact?${inquiryQuery(request)}`);
            });
        }
    </script>
    <style>

        .apparel-form {
            max-width: 520px;
            margin: 0 auto;
        }

        .apparel-form label {
            font-size: 1rem;
        }

        .apparel-form select,
        .apparel-form input[type="number"] {
            width: 100%;
            max-width: 420px;
            font-size: 16px;
            line-height: 1.25;
            padding: 10px 12px;
            min-height: 44px;
            box-sizing: border-box;
            border-radius: 8px;
            margin: 0 auto;
            display: block;
        }

        .apparel-form select:disabled,
        .apparel-form input:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

        .apparel-form .muted {
            font-size: 0.95rem;
        }

        .apparel-buttons{
            display:flex;
            justify-content:center;
            align-items:center;
            gap:16px;
            margin-top: 18px;
            flex-wrap: wrap;
        }

        .apparel-buttons .btn{
            min-width: 180px;
            text-align:center;
        }

        .btn-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            color: #fff;
        }

        .btn-link:visited {
            color: #fff;
        }
    </style>
</MainLayout>
