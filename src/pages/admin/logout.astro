---
import { isSameOriginRequest } from "../../utils/adminAuth";

// Logout is POST-only (the footer form in AdminLayout), so a cross-site link,
// image or prefetch can't sign the admin out. A GET (old bookmark) just goes
// to the dashboard, which sends signed-out visitors to the login page.
const request = Astro.request;
const noStore = { "Cache-Control": "no-store" };

if (request.method === "GET" || request.method === "HEAD") {
    return new Response(null, { status: 303, headers: { Location: "/admin/dashboard", ...noStore } });
}
if (request.method !== "POST") {
    return new Response("Method not allowed", { status: 405, headers: { Allow: "GET, POST", ...noStore } });
}
// Astro's checkOrigin covers form posts; this also refuses body-less
// cross-site POSTs, which checkOrigin does not inspect.
if (!isSameOriginRequest(request)) {
    return new Response("Forbidden", { status: 403, headers: noStore });
}

Astro.cookies.set("admin_auth", "", {
    path: "/",
    httpOnly: true,
    secure: import.meta.env.PROD,
    sameSite: "strict",
    maxAge: 0,
});

return new Response(null, {
    status: 303,
    headers: { Location: "/admin", ...noStore },
});
---
