---
import MainLayout from "../layout/MainLayout.astro";
import bizcard from "../assets/bizcard-front-new.jpg";
import "../styles/global.css";
import "../styles/contact.css";
import { TURNSTILE_SITE_KEY, CONTACT_ENDPOINT } from "../config/publicConfig";
import { CONTACT_LIMITS, MIN_NAME_LENGTH, MIN_MESSAGE_LENGTH, counterText } from "../lib/contact-limits.js";

const base = import.meta.env.BASE_URL;
const SITEKEY = TURNSTILE_SITE_KEY;
const ENDPOINT = CONTACT_ENDPOINT;
---
<MainLayout title="Contact | KIL Construction" description="Request an estimate or ask a question about your new construction, remodel, or custom cabinetry project in the Mondovi area.">
    <h1 class="contact-title">Request a Free Quote</h1>

    <div class="contact-grid">
        <!-- LEFT: quick info -->
        <section class="card contact-panel">
            <h2 class="heading2">Reach us directly</h2>
            <p><strong>Call / Text:</strong> <a href="tel:+17152791241">(715) 279-1241</a></p>
            <p><strong>Email:</strong> <a href="mailto:kil.con.contact@gmail.com">kil.con.contact@gmail.com</a></p>
            <p><strong>Facebook:</strong> <a href="https://www.facebook.com/profile.php?id=61559555097375" target="_blank" rel="noopener">KIL Construction</a></p>
            <p><a class="btn btn-vcard" href={`${base}KIL-Construction.vcf`} download>Download vCard</a></p>

            <a class="vcard-click" href={`${base}KIL-Construction.vcf`} download>
                <figure class="bizcard">
                    <img class="image-card" src={bizcard.src} alt="KIL Construction business card" loading="lazy" />
                </figure>
            </a>
        </section>

        <!-- RIGHT: form -->
        <section class="card contact-panel">
            <h2>Tell us about your project</h2>
            <p class="contact-helper">
                Already worked with us before?{" "}
                <a href="/reviews#leave-review" class="inline-link">Leave a review.</a>
            </p>
            <p id="inquiryNote" class="contact-helper" hidden></p>
            <div id="result" class="status status--empty" aria-live="polite"></div>
            <form class="contact-form" method="POST" action={ENDPOINT}>

                <label for="name">Name</label>
                <input id="name" name="name" required minlength={MIN_NAME_LENGTH} maxlength={CONTACT_LIMITS.name} autocomplete="name" placeholder="John Doe" />

                <label for="email">Email</label>
                <input id="email" name="email" type="email" required maxlength={CONTACT_LIMITS.email} autocomplete="email" placeholder="example@gmail.com"/>

                <label for="phone">Phone (optional)</label>
                <input id="phone" name="phone" type="tel" inputmode="tel" pattern="[0-9()+\-\s]{7,20}" maxlength={CONTACT_LIMITS.phone} autocomplete="tel" placeholder="(715) 867-5309"/>

                <label for="address">Job Address (optional)</label>
                <input id="address" name="address" maxlength={CONTACT_LIMITS.address} placeholder="123 Easy St."/>

                <label for="message" id="messageLabel">Project Details</label>
                <textarea id="message" name="message" rows="6" required minlength={MIN_MESSAGE_LENGTH} maxlength={CONTACT_LIMITS.message} aria-describedby="messageCount" placeholder="A brief description of your project."></textarea>
                <p id="messageCount" class="field-count">{counterText("")}</p>

                <!-- Honeypot -->
                <label>
                    <input type="text" name="company" tabindex="-1" autocomplete="off" style="display:none" />
                </label>

                <!-- Turnstile widget  -->
                <div
                    id="cf-container"
                    class="cf-turnstile"
                    data-sitekey={SITEKEY}
                    data-theme="auto"
                    data-size="normal"
                    data-refresh-expired="auto"
                    aria-label="Verification step to prevent spam and automated submissions">
                </div>

                <button class="btn" type="submit">Send</button>
            </form>

            <!-- Turnstile loader -->
            <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        </section>
    </div>
    <script>
        // Apparel "Request This Item" prefill (src/lib/apparel-inquiry.js). The form,
        // Turnstile and the Contact Worker are unchanged; the customer reviews and sends.
        // Name, email and notes arrive in sessionStorage (never the URL), are used once
        // and only for the item named in the URL, then removed.
        import {
            parseInquiry, formatInquiryMessage, decodeHandoff,
            NOTES_STORAGE_KEY, HANDOFF_STORAGE_KEY, INQUIRY_PARAM, INQUIRY_VALUE,
        } from "../lib/apparel-inquiry.js";
        import { encodeDraft, decodeDraft, DRAFT_STORAGE_KEY, DRAFT_FIELDS } from "../lib/contact-draft.js";
        import { CONTACT_LIMITS, lengthProblem, counterText } from "../lib/contact-limits.js";
        import { applyContactStatus } from "../lib/contact-status.js";

        // ?sent / ?err status line first (src/lib/contact-status.js): it removes its
        // parameter from the URL, and the draft restore below reads what it shows.
        applyContactStatus(document.getElementById("result"));

        const params = new URLSearchParams(window.location.search);
        if (params.get(INQUIRY_PARAM) === INQUIRY_VALUE) {
            let raw: string | null = null;
            try { raw = sessionStorage.getItem(HANDOFF_STORAGE_KEY); } catch { /* storage blocked */ }
            const handoff = decodeHandoff(raw, params.get("item") ?? "");
            const request = parseInquiry(params, handoff?.notes ?? "");
            if (request) {
                const fill = (id: string, value: string) => {
                    const field = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
                    if (field && value && !field.value.trim()) field.value = value; // never overwrite typed text
                };
                fill("name", handoff?.name ?? "");
                fill("email", handoff?.email ?? "");
                fill("message", formatInquiryMessage(request));
                const label = document.getElementById("messageLabel");
                if (label) label.textContent = "Request Details";
                const note = document.getElementById("inquiryNote");
                if (note) {
                    note.textContent = handoff
                        ? `Apparel request: ${request.title}. We've filled in your name, email and request. Check the details, complete the verification, then press Send.`
                        : `Apparel request: ${request.title}. Add your name and email, check the details, then press Send.`;
                    note.hidden = false;
                }
            }
            try {
                sessionStorage.removeItem(HANDOFF_STORAGE_KEY);
                sessionStorage.removeItem(NOTES_STORAGE_KEY);
            } catch { /* ignore */ }
        }

        // Draft restore (src/lib/contact-draft.js). applyContactStatus() above has
        // already shown ?sent / ?err and removed them from the URL, so read the
        // status it set: restore only after an error, otherwise discard.
        const contactForm = document.querySelector("form.contact-form") as HTMLFormElement | null;
        const returnedWithError = document.getElementById("result")?.classList.contains("status--error");
        try {
            const draft = returnedWithError ? decodeDraft(sessionStorage.getItem(DRAFT_STORAGE_KEY)) : null;
            sessionStorage.removeItem(DRAFT_STORAGE_KEY);
            if (draft && contactForm) {
                for (const [k, v] of Object.entries(draft)) {
                    const field = contactForm.elements.namedItem(k) as HTMLInputElement | HTMLTextAreaElement | null;
                    if (field && v && !field.value.trim()) field.value = v;
                }
            }
        } catch { /* storage blocked */ }
        // Length limits (src/lib/contact-limits.js, matching the Contact Worker).
        // maxlength stops typing past a limit, but text filled in by script (an
        // apparel prefill or a restored draft) is not checked by the browser, so
        // every limited field is checked again with a clear message.
        const limited = Object.keys(CONTACT_LIMITS)
            .map((k) => contactForm?.elements.namedItem(k) as HTMLInputElement | HTMLTextAreaElement | null)
            .filter((f): f is HTMLInputElement | HTMLTextAreaElement => !!f);
        const counter = document.getElementById("messageCount");
        const messageField = contactForm?.elements.namedItem("message") as HTMLTextAreaElement | null;
        const updateCounter = () => {
            if (!counter || !messageField) return;
            counter.textContent = counterText(messageField.value);
            counter.classList.toggle("field-count--over", messageField.value.trim().length > CONTACT_LIMITS.message);
        };
        const check = (field: HTMLInputElement | HTMLTextAreaElement) => {
            field.setCustomValidity(lengthProblem(field.name, field.value));
        };
        for (const field of limited) {
            check(field);
            field.addEventListener("input", () => { check(field); if (field === messageField) updateCounter(); });
        }
        updateCounter();
        contactForm?.addEventListener("submit", (event) => {
            for (const field of limited) check(field);
            if (!contactForm.checkValidity()) {
                event.preventDefault();
                event.stopImmediatePropagation(); // nothing is sent, so no draft is saved
                contactForm.reportValidity();
            }
        });
        contactForm?.addEventListener("submit", () => {
            const values: Record<string, string> = {};
            for (const k of Object.keys(DRAFT_FIELDS)) {
                const field = contactForm.elements.namedItem(k) as HTMLInputElement | HTMLTextAreaElement | null;
                values[k] = field?.value ?? "";
            }
            try { sessionStorage.setItem(DRAFT_STORAGE_KEY, encodeDraft(values)); } catch { /* storage blocked */ }
        });
    </script>
</MainLayout>