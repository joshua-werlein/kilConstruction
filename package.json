{
  "name": "kilconstruction",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:gallery-worker": "node --test workers/kilcon-gallery-worker/test/*.test.mjs",
    "test:site": "node --test tests/*.test.mjs",
    "site:dry-run": "astro build && wrangler deploy --dry-run --config dist/server/wrangler.json",
    "gallery-worker:dry-run": "wrangler deploy --dry-run --config workers/kilcon-gallery-worker/wrangler.toml",
    "gallery-worker:upload": "wrangler versions upload --config workers/kilcon-gallery-worker/wrangler.toml",
    "contact-worker:dry-run": "wrangler deploy --dry-run --config workers/kilcon-contact/wrangler.toml"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261122.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
